# ══════════════════════════════════════════════════════════════════════════════
#  .env.example — JeCréeMaBoutique / Backend Next.js
#  Copier ce fichier en .env.local et remplir toutes les valeurs.
#  NE JAMAIS committer .env.local dans git.
# ══════════════════════════════════════════════════════════════════════════════


# ── BASE DE DONNÉES ────────────────────────────────────────────────────────────
# Dev local     : mongodb://localhost:27017/burkina-shop
# Docker compose: mongodb://mongodb:27017/burkina-shop
# Production    : mongodb+srv://<user>:<pass>@cluster.mongodb.net/<db>
MONGODB_URI=mongodb://localhost:27017/burkina-shop


# ── AUTH JWT ───────────────────────────────────────────────────────────────────
# Générer un secret fort :  openssl rand -base64 64
JWT_SECRET=remplacer_par_un_secret_fort_minimum_64_caracteres
JWT_EXPIRES_IN=7d


# ── URLS ───────────────────────────────────────────────────────────────────────
# URL publique de ce serveur Next.js (injectée dans les og:image URLs)
# Dev local : http://localhost:4000
# Production : https://easyorder-backend-wnku.onrender.com
NEXT_PUBLIC_BASE_URL=http://localhost:4000

# URL du frontend Angular (pour CORS et les redirections utilisateurs)
# Dev local : http://localhost:4200
# Production : https://www.jecreemaboutique.com
FRONTEND_URL=http://localhost:4200


# ── CLOUDINARY (stockage images) ───────────────────────────────────────────────
# Compte sur https://cloudinary.com (gratuit jusqu'à 25GB)
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret


# ── OPEN GRAPH — CACHE INVALIDATION ───────────────────────────────────────────
# Secret pour l'endpoint POST /api/og/invalidate
# Appeler quand une boutique met à jour ses produits/logo
# Générer : openssl rand -hex 32
CACHE_INVALIDATION_SECRET=remplacer_par_un_secret_hex_32


# ── WEB PUSH NOTIFICATIONS ────────────────────────────────────────────────────
# Générer les clés VAPID : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=votre_vapid_public_key
VAPID_PRIVATE_KEY=votre_vapid_private_key
VAPID_SUBJECT=mailto:contact@jecreemaboutique.com


# ── OPTIONNEL — NODE ───────────────────────────────────────────────────────────
# Désactiver la télémétrie Next.js
NEXT_TELEMETRY_DISABLED=1
